# Safe defaults. Do NOT commit production credentials.
RELEASE_READY=0
ANALYTICS_ENABLED=0
ADS_ENABLED=0
RECRUITER_LITE_ENABLED=0
PARTNER_POSTING_API_ENABLED=0
OWNER_PANEL_ENABLED=0
# Generate a strong password hash using PHP password_hash(PASSWORD_DEFAULT).
# Never write a real owner password here, in command arguments, in the repo, or in an issue.
OWNER_PASSWORD_HASH=
# Independent random >= 32-character secret, stored in hosting environment only.
OWNER_RATE_SECRET=

# Future INVITE-ONLY partner pilot: do not enable without verified employer identity,
# live email/domain checks, owner moderation, TLS, real MySQL migration and backup.
PARTNER_PILOT_VERIFIED=0
PARTNER_TOKEN_ADMIN_ENABLED=0
PARTNER_TERMS_VERSION=pilot-terms-v1
PARTNER_TOKEN_HMAC_SECRET=
PARTNER_DB_DSN=
PARTNER_DB_USER=
PARTNER_DB_PASSWORD=

# Gated M12/M13 employer browser, owner-reviewed public postings.
# DO NOT enable before MySQL migrations 001/002/003, verified operator approvals,
# real outbound email and restore drills on Hostinger staging are demonstrated.
EMPLOYER_REVIEW_ENABLED=0
EMPLOYER_PUBLIC_ENABLED=0
RECRUITER_PORTAL_ENABLED=0
RECRUITER_MAIL_ENABLED=0
# >=32 independent randomly-generated chars, never reuse API HMAC secret.
RECRUITER_AUTH_HMAC_SECRET=
# Outbound mailbox and verified HTTPS STAGING URL (do not configure the public domain by default).
RECRUITER_EMAIL_FROM=
RECRUITER_VERIFY_URL=
RECRUITER_RESET_URL=

# Private CLI DNS TXT challenge/check (never automatic organisation approval).
OWNER_DOMAIN_ADMIN_ENABLED=0
